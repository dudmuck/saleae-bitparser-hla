function(capture_case scenario expected)
    set(output "${FIRMWARE}/../capture-test.raw")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env
        "DSLCAP_TEST_SCENARIO=${scenario}" "${PROGRAM}" --fw-dir "${FIRMWARE}"
        --channels 0-7 --samplerate 25M --samples 73
        RESULT_VARIABLE code OUTPUT_FILE "${output}" ERROR_VARIABLE err TIMEOUT 10)
    if(NOT "${code}" STREQUAL "${expected}")
        message(FATAL_ERROR "${scenario}: expected ${expected}, got ${code}\n${err}")
    endif()
    if(NOT err MATCHES "FAKE cleanup")
        message(FATAL_ERROR "${scenario}: no cleanup\n${err}")
    endif()
    if(expected EQUAL 0)
        file(SIZE "${output}" size)
        if(NOT size EQUAL 99)
            message(FATAL_ERROR "${scenario}: wrong META plus finite payload size ${size}")
        endif()
    endif()
    message(STATUS "${scenario}: exit ${code}, cleanup verified")
endfunction()
