function(cli_case expected)
    execute_process(COMMAND "${PROGRAM}" --fw-dir "${FIRMWARE}" ${ARGN}
        RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 10)
    if(NOT "${code}" STREQUAL "${expected}")
        message(FATAL_ERROR "CLI ${ARGN}: expected ${expected}, got ${code}\n${err}")
    endif()
    if(expected EQUAL 8 AND err MATCHES "FAKE init" AND NOT err MATCHES "FAKE cleanup")
        message(FATAL_ERROR "CLI ${ARGN}: initialized driver without cleanup")
    endif()
endfunction()
